WallTexture TUE1SKY, 7096, 887
{
    // Four proportional panels fill Doom's sky cylinder with brown terrain
    // and stars, without adding a separate planet object.
    XScale 6.9296875
    YScale 6.9296875
    Patch "textures/tuindoom/e1terrain360.png", 0, 0
}

WallTexture TUE2SKY, 1776, 887
{
    // One wide Deimos panorama fills the sky cylinder. The red rift is part of
    // the artwork; its matching directional light intentionally has no sun disc.
    XScale 1.734375
    YScale 1.734375
    Patch "textures/tuindoom/e2deimos360.png", 0, 0
}
