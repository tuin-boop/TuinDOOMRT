WallTexture TUE1SKY, 7096, 887
{
    // Four proportional panels fill Doom's sky cylinder with brown terrain
    // and stars, without adding a separate planet object.
    XScale 6.9296875
    YScale 6.9296875
    Patch "textures/tuindoom/e1terrain360.png", 0, 0
}

WallTexture TUE2SKY, 7096, 887
{
    // Four proportional panels match Doom's 1024x128 virtual sky strip, keeping
    // the Deimos ground visible without vertically squashing the artwork.
    XScale 6.9296875
    YScale 6.9296875
    Patch "textures/tuindoom/e2deimos360-v2.png", 0, 0
    Patch "textures/tuindoom/e2deimos360-v2.png", 1774, 0
    Patch "textures/tuindoom/e2deimos360-v2.png", 3548, 0
    Patch "textures/tuindoom/e2deimos360-v2.png", 5322, 0
}

